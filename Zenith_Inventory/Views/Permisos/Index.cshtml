@{
    ViewBag.Title = "Gesti�n de Permisos";
}

@section Styles {
    <link href="~/Content/css/Usuarios/usuarios.css" rel="stylesheet" />
    <link href="~/Content/css/Usuarios/permisos.css" rel="stylesheet" />    
    
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="~/Content/css/select2-custom.css" rel="stylesheet" />
}

@section Scripts {    
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/Scripts/Usuarios/permisos.js"></script>
}

<div class="container-fluid px-4">
    <h2 class="page-title-custom mb-4">
        <i class="fas fa-shield-alt me-2"></i>@ViewBag.Title
    </h2>

    <!-- Barra de b�squeda y filtros -->
    <div class="search-container mb-4">
        <div class="row g-2">
            <!-- B�squeda -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchPermisos" class="form-control" placeholder="Buscar permisos..." />
                </div>
            </div>
            
            <!-- Filtro M�dulo -->
            <div class="col-6 col-md-3 col-lg-2">
                <select id="filterPermisosModulo" class="form-control">
                    <option value="">Todos los m�dulos</option>
                    <!-- M�dulos se cargar�n din�micamente -->
                </select>
            </div>
            
            <!-- Filtro Acci�n -->
            <div class="col-6 col-md-3 col-lg-2">
                <select id="filterPermisosAccion" class="form-control">
                    <option value="">Todas las acciones</option>
                    <!-- Acciones se cargar�n din�micamente -->
                </select>
            </div>
            
            <!-- Filtro Estado -->
            <div class="col-6 col-md-4 col-lg-2">
                <select id="filterPermisosStatus" class="form-control">
                    <option value="activos">Solo Activos</option>
                    <option value="todos">Todos</option>
                    <option value="inactivos">Solo Inactivos</option>
                </select>
            </div>
            
            <!-- Botones de Acci�n -->
            <div class="col-6 col-md-8 col-lg-2 d-flex justify-content-end gap-2">
                <button id="btnClearFilters" class="btn btn-outline-warning" title="Limpiar filtros">
                    <i class="fas fa-eraser"></i>
                </button>
                <button id="btnRefreshPermisos" class="btn btn-outline-secondary" title="Recargar">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <button id="btnAddPermiso" class="btn btn-primary flex-grow-1 flex-lg-grow-0">
                    <i class="fas fa-shield-alt d-none d-lg-inline me-2"></i>
                    <span class="d-lg-inline">Nuevo</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla de permisos -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table-striped table-hover table" id="permisosTable">
                <thead>
                    <tr>
                        <th style="width: 25%;">Nombre</th>
                        <th style="width: 15%;">M�dulo</th>
                        <th style="width: 15%;">Acci�n</th>
                        <th style="width: 25%;">Descripci�n</th>
                        <th class="text-center" style="width: 8%;">Roles</th>
                        <th class="text-center" style="width: 10%;">Estado</th>
                        <th class="text-center" style="width: 15%;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="permisosBody">
                    <tr>
                        <td colspan="7" class="text-muted py-4 text-center">
                            <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                            <p>Cargando permisos...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div id="paginationPermisosContainer" class="d-flex justify-content-center mt-3">
            <!-- Pagination will be loaded here -->
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL PARA CREAR/EDITAR PERMISO -->
<!-- ============================================= -->
<div class="modal fade" id="permisoModal" tabindex="-1" role="dialog" aria-labelledby="permisoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <!-- Header -->
            <div class="modal-header detail-modal-header">
                <div class="d-flex align-items-center w-100">
                    <div class="detail-icon-box me-3">
                        <i class="fas fa-shield-alt" id="permisoModalIcon"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="modal-title" id="permisoModalLabel">Nuevo Permiso</h5>
                        <small class="detail-subtitle-header">Complete la informaci�n requerida</small>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <form id="permisoForm">
                    <input type="hidden" id="permisoId" />
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="permisoNombre" class="form-label">
                                <i class="fas fa-tag text-primary me-1"></i>Nombre <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="permisoNombre" class="form-control" placeholder="Ej: Gesti�n de Inventario" required />
                            <small class="text-muted">Nombre descriptivo del permiso</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="permisoModulo" class="form-label">
                                <i class="fas fa-cube text-primary me-1"></i>M�dulo <span class="text-danger">*</span>
                            </label>
                            <select id="permisoModulo" class="form-control" required>
                                <option value="">-- Seleccione un m�dulo --</option>
                                <!-- Se llenar� din�micamente -->
                            </select>
                            <small class="text-muted">M�dulo al que pertenece el permiso</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="permisoAccion" class="form-label">
                                <i class="fas fa-bolt text-primary me-1"></i>Acci�n <span class="text-danger">*</span>
                            </label>
                            <select id="permisoAccion" class="form-control" required>
                                <option value="">-- Seleccione una acci�n --</option>
                                <!-- Se llenar� din�micamente -->
                            </select>
                            <small class="text-muted">Tipo de acci�n que permite (CREAR, LEER, etc.)</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="permisoDescripcion" class="form-label">
                            <i class="fas fa-align-left text-primary me-1"></i>Descripci�n
                        </label>
                        <textarea id="permisoDescripcion" class="form-control" rows="2" placeholder="Descripci�n opcional del permiso"></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="permisoActivo" class="form-check-input" checked />
                        <label class="form-check-label" for="permisoActivo">
                            <i class="fas fa-toggle-on text-primary me-1"></i>Permiso activo
                        </label>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" id="btnSavePermiso" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL PARA VER DETALLES DEL PERMISO -->
<!-- ============================================= -->
<div class="modal fade" id="viewPermisoModal" tabindex="-1" aria-labelledby="viewPermisoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <!-- Header -->
            <div class="modal-header detail-modal-header">
                <div class="d-flex align-items-center w-100">
                    <div class="detail-icon-box me-3">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="modal-title mb-0" id="viewPermisoModalLabel">Detalles del Permiso</h5>
                        <small class="detail-subtitle-header">Informaci�n completa del permiso</small>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body p-0">
                <!-- Informaci�n Principal -->
                <div class="detail-main-info">
                    <div class="row g-0">
                        <div class="col-8">
                            <div class="p-4">
                                <div class="mb-3">
                                    <label class="detail-field-label">
                                        <i class="fas fa-tag me-2"></i>Nombre del Permiso
                                    </label>
                                    <h4 class="detail-field-value" id="viewPermisoNombre">--</h4>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <label class="detail-field-label">
                                            <i class="fas fa-cube me-2"></i>M�dulo
                                        </label>
                                        <p class="detail-field-text mb-0">
                                            <span class="badge bg-primary" id="viewPermisoModulo">--</span>
                                        </p>
                                    </div>
                                    <div class="col-6">
                                        <label class="detail-field-label">
                                            <i class="fas fa-bolt me-2"></i>Acci�n
                                        </label>
                                        <p class="detail-field-text mb-0">
                                            <span class="badge bg-info" id="viewPermisoAccion">--</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="detail-status-section">
                                <label class="detail-field-label d-block mb-2 text-center">
                                    <i class="fas fa-info-circle me-1"></i>Estado
                                </label>
                                <span id="viewPermisoActivo" class="status-badge-large d-block mb-2">--</span>
                                <small class="detail-id-text">ID: <strong id="viewPermisoId">--</strong></small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Descripci�n -->
                <div class="detail-description-section">
                    <div class="detail-section-header">
                        <i class="fas fa-align-left me-2"></i>
                        <span>Descripci�n</span>
                    </div>
                    <div class="detail-section-body">
                        <p class="detail-description-text" id="viewPermisoDescripcion">Sin descripci�n disponible</p>
                    </div>
                </div>

                <!-- Roles que tienen este permiso -->
                <div class="detail-roles-section bg-light p-4">
                    <h6 class="mb-3">
                        <i class="fas fa-user-shield text-primary me-2"></i>
                        Roles con este permiso <span class="badge bg-primary" id="viewPermisoTotalRoles">0</span>
                    </h6>
                    <div id="viewPermisoRolesList" class="roles-list-container">
                        <!-- Roles will be loaded here -->
                    </div>
                </div>

                <!-- Auditor�a -->
                <div class="detail-stats-section">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-icon bg-success">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                                <div class="stat-content">
                                    <span class="stat-label">Creado por</span>
                                    <span class="stat-creator" id="viewPermisoUsuarioCreacion">Sistema</span>
                                    <span class="stat-date" id="viewPermisoFechaCreacion">--/--/----</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-icon bg-warning">
                                    <i class="fas fa-user-edit"></i>
                                </div>
                                <div class="stat-content">
                                    <span class="stat-label">Modificado por</span>
                                    <span class="stat-creator" id="viewPermisoUsuarioModificacion">--</span>
                                    <span class="stat-date" id="viewPermisoFechaModificacion">--/--/----</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cerrar
                </button>
                <button type="button" class="btn btn-primary" id="btnEditPermisoFromView">
                    <i class="fas fa-edit me-1"></i>Editar
                </button>
            </div>
        </div>
    </div>
</div>
