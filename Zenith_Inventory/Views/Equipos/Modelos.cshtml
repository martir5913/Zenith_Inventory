@{
    ViewBag.Title = "Gestión de Modelos";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-2">Gestión de Modelos</h1>
                <p class="text-muted mb-0">Administra los modelos de equipos del inventario</p>
            </div>
            <div>
                <button class="btn btn-primary" id="btnNuevoModelo">
                    <i class="bi bi-plus-circle"></i> Nuevo Modelo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-box"></i> Modelos Registrados
                    </h5>
                </div>
            </div>
            <div class="card-body">
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                    </div>
                    <h5 class="text-muted">Módulo en Desarrollo</h5>
                    <p class="text-muted mb-3">
                        La gestión de modelos de equipos está siendo implementada.<br>
                        Pronto podrás crear y administrar los modelos por marca.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="@Url.Action("Index", "Equipos")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Volver a Equipos
                        </a>
                        <a href="@Url.Action("Categorias", "Equipos")" class="btn btn-outline-primary">
                            <i class="bi bi-tag"></i> Ir a Categorías
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <style>
        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
    </style>

    <script>
        $(document).ready(function () {
            $('#btnNuevoModelo').click(function () {
                alert('Funcionalidad en desarrollo');
            });
        });
    </script>
}
