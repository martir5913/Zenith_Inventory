@{
    ViewBag.Title = "Dashboard";
}

@section Styles {
    @* Bundle de estilos del dashboard - Minifica automáticamente en producción *@
    @Styles.Render("~/Content/dashboard")
}

<!-- Dashboard Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-2">Bienvenido, @Session["UserName"]</h1>
                <p class="text-muted mb-0">Panel de control del sistema de inventario</p>
            </div>
            <div>
                <span class="badge bg-primary">Sistema Activo</span>
            </div>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <!-- Total Equipos -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Total Equipos</h6>
                        <h2 class="mb-0">1,234</h2>
                        <small class="text-success"><i class="bi bi-arrow-up"></i> 12% vs mes anterior</small>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-laptop fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Equipos Asignados -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Equipos Asignados</h6>
                        <h2 class="mb-0">856</h2>
                        <small class="text-info"><i class="bi bi-arrow-right"></i> 69% del total</small>
                    </div>
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-person-check fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Disponibles -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Disponibles</h6>
                        <h2 class="mb-0">378</h2>
                        <small class="text-warning"><i class="bi bi-dash"></i> 31% del total</small>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Usuarios Activos -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Usuarios Activos</h6>
                        <h2 class="mb-0">425</h2>
                        <small class="text-success"><i class="bi bi-arrow-up"></i> 8% vs mes anterior</small>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-people fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts and Tables -->
<div class="row g-3 mb-4">
    <!-- Recent Activity -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Actividad Reciente</h5>
                    <a href="#" class="btn btn-sm btn-outline-primary">Ver todo</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Acción</th>
                                <th>Equipo</th>
                                <th>Usuario</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>2025-02-11 14:30</td>
                                <td><span class="badge bg-success">Asignación</span></td>
                                <td>Dell Latitude 5420</td>
                                <td>Juan Pérez</td>
                                <td><i class="bi bi-check-circle text-success"></i></td>
                            </tr>
                            <tr>
                                <td>2025-02-11 13:15</td>
                                <td><span class="badge bg-primary">Ingreso</span></td>
                                <td>HP ProBook 450</td>
                                <td>Sistema</td>
                                <td><i class="bi bi-check-circle text-success"></i></td>
                            </tr>
                            <tr>
                                <td>2025-02-11 11:45</td>
                                <td><span class="badge bg-warning">Devolución</span></td>
                                <td>Lenovo ThinkPad X1</td>
                                <td>María García</td>
                                <td><i class="bi bi-clock text-warning"></i></td>
                            </tr>
                            <tr>
                                <td>2025-02-11 10:20</td>
                                <td><span class="badge bg-info">Transferencia</span></td>
                                <td>Dell Optiplex 7090</td>
                                <td>Carlos López</td>
                                <td><i class="bi bi-check-circle text-success"></i></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0">Estado de Equipos</h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Asignados</span>
                        <strong>69%</strong>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" style="width: 69%"></div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Disponibles</span>
                        <strong>31%</strong>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 31%"></div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>En Reparación</span>
                        <strong>5%</strong>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: 5%"></div>
                    </div>
                </div>

                <hr>

                <div class="mt-4">
                    <h6 class="mb-3">Acciones Rápidas</h6>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Create", "Equipos")" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle"></i> Nuevo Equipo
                        </a>
                        <a href="@Url.Action("Ingresos", "Inventario")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-box-arrow-in-down"></i> Registrar Ingreso
                        </a>
                        <a href="@Url.Action("Egresos", "Inventario")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-box-arrow-up"></i> Registrar Egreso
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Info -->
<div class="row g-3">
    <!-- Equipment by Category -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0">Equipos por Categoría</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div>
                            <i class="bi bi-laptop text-primary"></i>
                            <span class="ms-2">Computadoras</span>
                        </div>
                        <span class="badge bg-primary rounded-pill">685</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div>
                            <i class="bi bi-router text-info"></i>
                            <span class="ms-2">Redes</span>
                        </div>
                        <span class="badge bg-info rounded-pill">234</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div>
                            <i class="bi bi-printer text-success"></i>
                            <span class="ms-2">Impresoras</span>
                        </div>
                        <span class="badge bg-success rounded-pill">187</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div>
                            <i class="bi bi-hdd text-warning"></i>
                            <span class="ms-2">Periféricos</span>
                        </div>
                        <span class="badge bg-warning rounded-pill">128</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Users -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0">Usuarios con Más Equipos</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">Juan Pérez</h6>
                                <small class="text-muted">Departamento IT</small>
                            </div>
                        </div>
                        <span class="badge bg-primary rounded-pill">8 equipos</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">María García</h6>
                                <small class="text-muted">Ventas</small>
                            </div>
                        </div>
                        <span class="badge bg-info rounded-pill">6 equipos</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">Carlos López</h6>
                                <small class="text-muted">RRHH</small>
                            </div>
                        </div>
                        <span class="badge bg-success rounded-pill">5 equipos</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>