@{
    ViewBag.Title = "Gestión de Roles";
}

@section Styles {
    <link href="~/Content/css/Usuarios/usuarios.css" rel="stylesheet" />
    <link href="~/Content/css/Usuarios/roles.css" rel="stylesheet" />
    
    @* Cargar Select2 CSS solo en esta página *@
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="~/Content/css/select2-custom.css" rel="stylesheet" />
}

@section Scripts {
    @* Cargar Select2 JS solo en esta página *@
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    @* Script de roles *@
    <script src="~/Scripts/Usuarios/roles.js"></script>
}

<div class="container-fluid px-4">
    <h2 class="page-title-custom mb-4">
        <i class="fas fa-user-shield me-2"></i>@ViewBag.Title
    </h2>

    <!-- Barra de búsqueda y filtros -->
    <div class="search-container mb-4">
        <div class="row g-2">
            <!-- Búsqueda -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchRoles" class="form-control" placeholder="Buscar roles..." />
                </div>
            </div>
            
            <!-- Filtro Estado -->
            <div class="col-6 col-md-3 col-lg-2">
                <select id="filterRolesStatus" class="form-control">
                    <option value="activos">Solo Activos</option>
                    <option value="todos">Todos</option>
                    <option value="inactivos">Solo Inactivos</option>
                </select>
            </div>
            
            <!-- Botones de Acción -->
            <div class="col-6 col-md-9 col-lg-6 d-flex justify-content-end gap-2">
                <button id="btnClearFilters" class="btn btn-outline-warning" title="Limpiar filtros">
                    <i class="fas fa-eraser"></i>
                </button>
                <button id="btnRefreshRoles" class="btn btn-outline-secondary" title="Recargar">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <button id="btnAddRol" class="btn btn-primary flex-grow-1 flex-lg-grow-0">
                    <i class="fas fa-user-shield d-none d-lg-inline me-2"></i>
                    <span class="d-lg-inline">Nuevo Rol</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla de roles -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="rolesTable">
                <thead>
                    <tr>
                        <th style="width: 20%;">Nombre</th>
                        <th style="width: 35%;">Descripción</th>
                        <th class="text-center" style="width: 10%;">Usuarios</th>
                        <th class="text-center" style="width: 10%;">Permisos</th>
                        <th class="text-center" style="width: 10%;">Estado</th>
                        <th class="text-center" style="width: 15%;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="rolesBody">
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                            <p>Cargando roles...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div id="paginationRolesContainer" class="d-flex justify-content-center mt-3">
            <!-- Pagination will be loaded here -->
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL PARA CREAR/EDITAR ROL -->
<!-- ============================================= -->
<div class="modal fade" id="rolModal" tabindex="-1" role="dialog" aria-labelledby="rolModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <!-- Header -->
            <div class="modal-header detail-modal-header">
                <div class="d-flex align-items-center w-100">
                    <div class="detail-icon-box me-3">
                        <i class="fas fa-user-shield" id="rolModalIcon"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="modal-title" id="rolModalLabel">Nuevo Rol</h5>
                        <small class="detail-subtitle-header">Complete la información requerida</small>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <form id="rolForm">
                    <input type="hidden" id="rolId" />
                    
                    <div class="mb-3">
                        <label for="rolNombre" class="form-label">
                            <i class="fas fa-tag text-primary me-1"></i>Nombre <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="rolNombre" class="form-control" placeholder="Ej: Administrador de Inventario" required />
                        <small class="text-muted">Nombre descriptivo del rol</small>
                    </div>

                    <div class="mb-3">
                        <label for="rolDescripcion" class="form-label">
                            <i class="fas fa-align-left text-primary me-1"></i>Descripción
                        </label>
                        <textarea id="rolDescripcion" class="form-control" rows="3" placeholder="Descripción del rol y sus responsabilidades"></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="rolActivo" class="form-check-input" checked />
                        <label class="form-check-label" for="rolActivo">
                            <i class="fas fa-toggle-on text-primary me-1"></i>Rol activo
                        </label>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" id="btnSaveRol" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL PARA VER DETALLES DEL ROL -->
<!-- ============================================= -->
<div class="modal fade" id="viewRolModal" tabindex="-1" aria-labelledby="viewRolModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content border-0 shadow-lg">
            <!-- Header -->
            <div class="modal-header detail-modal-header">
                <div class="d-flex align-items-center w-100">
                    <div class="detail-icon-box me-3">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="modal-title mb-0" id="viewRolModalLabel">Detalles del Rol</h5>
                        <small class="detail-subtitle-header">Información completa del rol y sus permisos</small>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Body con diseño de 2 columnas -->
            <div class="modal-body p-0">
                <div class="row g-0">
                    <!-- COLUMNA IZQUIERDA: Información del Rol -->
                    <div class="col-md-4 border-end">
                        <div class="rol-info-section">
                            <!-- Información Principal -->
                            <div class="detail-main-info border-bottom">
                                <div class="p-4">
                                    <label class="detail-field-label">
                                        <i class="fas fa-user-shield me-2"></i>Nombre del Rol
                                    </label>
                                    <h4 class="detail-field-value mb-3" id="viewRolNombre">--</h4>
                                    
                                    <label class="detail-field-label mt-3">
                                        <i class="fas fa-info-circle me-2"></i>Estado
                                    </label>
                                    <div class="mb-3">
                                        <span id="viewRolActivo" class="status-badge-large">--</span>
                                        <small class="detail-id-text d-block mt-2">ID: <strong id="viewRolId">--</strong></small>
                                    </div>
                                </div>
                            </div>

                            <!-- Descripción -->
                            <div class="detail-description-section border-bottom">
                                <div class="detail-section-header">
                                    <i class="fas fa-align-left me-2"></i>
                                    <span>Descripción</span>
                                </div>
                                <div class="detail-section-body">
                                    <p class="detail-description-text" id="viewRolDescripcion">Sin descripción disponible</p>
                                </div>
                            </div>

                            <!-- Estadísticas -->
                            <div class="detail-stats-section border-bottom">
                                <div class="p-3">
                                    <div class="stat-card mb-2">
                                        <div class="stat-icon bg-primary">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <div class="stat-content">
                                            <span class="stat-label">Usuarios Asignados</span>
                                            <span class="stat-value" id="viewRolTotalUsuarios">0</span>
                                        </div>
                                    </div>
                                    <div class="stat-card">
                                        <div class="stat-icon bg-info">
                                            <i class="fas fa-shield-alt"></i>
                                        </div>
                                        <div class="stat-content">
                                            <span class="stat-label">Permisos Asignados</span>
                                            <span class="stat-value" id="viewRolTotalPermisos">0</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Auditoría -->
                            <div class="detail-stats-section">
                                <div class="p-3">
                                    <div class="stat-card mb-2">
                                        <div class="stat-icon bg-success">
                                            <i class="fas fa-user-plus"></i>
                                        </div>
                                        <div class="stat-content">
                                            <span class="stat-label">Creado por</span>
                                            <span class="stat-creator" id="viewRolUsuarioCreacion">Sistema</span>
                                            <span class="stat-date" id="viewRolFechaCreacion">--/--/----</span>
                                        </div>
                                    </div>
                                    <div class="stat-card">
                                        <div class="stat-icon bg-warning">
                                            <i class="fas fa-user-edit"></i>
                                        </div>
                                        <div class="stat-content">
                                            <span class="stat-label">Modificado por</span>
                                            <span class="stat-creator" id="viewRolUsuarioModificacion">--</span>
                                            <span class="stat-date" id="viewRolFechaModificacion">--/--/----</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- COLUMNA DERECHA: Matriz de Permisos -->
                    <div class="col-md-8">
                        <div class="permisos-matriz-section">
                            <div class="permisos-header">
                                <div class="d-flex align-items-center justify-content-between px-3 py-2">
                                    <div>
                                        <i class="fas fa-shield-alt me-2 text-white"></i>
                                        <span class="fw-bold text-white">Matriz de Permisos</span>
                                    </div>
                                    <div>
                                        <span class="badge bg-white text-primary" id="permisosCount">0</span>
                                    </div>
                                </div>
                            </div>
                            <div class="permisos-body" id="viewRolPermisosList">
                                <!-- Matriz will be loaded here -->
                                <div class="text-center py-5">
                                    <i class="fas fa-spinner fa-spin fa-2x text-muted mb-3"></i>
                                    <p class="text-muted">Cargando matriz de permisos...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cerrar
                </button>
                <button type="button" class="btn btn-info" id="btnAsignarPermisos">
                    <i class="fas fa-shield-alt me-1"></i>Asignar Permisos
                </button>
                <button type="button" class="btn btn-primary" id="btnEditRolFromView">
                    <i class="fas fa-edit me-1"></i>Editar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL PARA ASIGNAR PERMISOS -->
<!-- ============================================= -->
<div class="modal fade" id="asignarPermisosModal" tabindex="-1" aria-labelledby="asignarPermisosModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content border-0 shadow-lg">
            <!-- Header -->
            <div class="modal-header detail-modal-header">
                <div class="d-flex align-items-center w-100">
                    <div class="detail-icon-box me-3">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="modal-title mb-0" id="asignarPermisosModalLabel">Asignar Permisos al Rol</h5>
                        <small class="detail-subtitle-header" id="asignarPermisosRolNombre">--</small>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body p-0">
                <input type="hidden" id="asignarPermisosRolId" />
                
                <!-- Header con contador y acciones rápidas -->
                <div class="permisos-asignar-header">
                    <div class="row g-0 align-items-center px-3 py-2">
                        <div class="col-md-6">
                            <div class="permisos-stats">
                                <div class="stat-item">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="stat-label">Asignados:</span>
                                    <strong class="stat-number text-success" id="permisosAsignadosCount">0</strong>
                                </div>
                                <div class="stat-item ms-3">
                                    <i class="fas fa-shield-alt text-primary me-2"></i>
                                    <span class="stat-label">Total disponibles:</span>
                                    <strong class="stat-number text-primary" id="permisosTotalCount">0</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-success" id="btnSeleccionarTodos">
                                    <i class="fas fa-check-double me-1"></i>Seleccionar Todos
                                </button>
                                <button type="button" class="btn btn-outline-danger" id="btnDeseleccionarTodos">
                                    <i class="fas fa-times me-1"></i>Deseleccionar Todos
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Matriz de permisos editable -->
                <div class="permisos-matriz-editable" id="permisosMatrizEditable">
                    <!-- Loading state -->
                    <div class="text-center py-5">
                        <i class="fas fa-spinner fa-spin fa-2x text-muted mb-3"></i>
                        <p class="text-muted">Cargando permisos...</p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" id="btnGuardarPermisos" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar Permisos
                </button>
            </div>
        </div>
    </div>
</div>
