<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Zenith Inventory</title>
    <link rel="icon" type="image/x-icon" href="~/Content/img/favicon.ico">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <!-- FontAwesome CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    @* ✅ REMOVIDO: Select2 CSS ya NO se carga globalmente *@
    @* Las páginas que lo necesiten deben cargarlo explícitamente en @section Styles *@
    @* <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> *@
    @* <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" /> *@
    @* <link href="~/Content/css/select2-custom.css" rel="stylesheet" /> *@

    @Styles.Render("~/Content/css")
    <link href="~/Content/css/layout.css" rel="stylesheet" />

    @RenderSection("Styles", false)
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-icon">
                    <span class="logo-text">Z</span>
                </div>
                <div class="logo-full">
                    <h1 class="logo-title">Zenith</h1>
                    <p class="logo-subtitle">Inventory</p>
                </div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <ul class="nav-list">
                <!-- Dashboard -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Home")"
                       class="nav-link"
                       data-controller="Home"
                       data-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span class="nav-text">Dashboard</span>
                    </a>
                </li>

                <!-- Equipos -->
                <li class="nav-item">
                    <a href="#equiposSubmenu"
                       class="nav-link"
                       data-bs-toggle="collapse"
                       data-controller="Equipos,Inventario">
                        <i class="bi bi-laptop"></i>
                        <span class="nav-text">Equipos</span>
                        <i class="bi bi-chevron-down arrow-icon"></i>
                    </a>
                    <ul class="submenu collapse" id="equiposSubmenu">
                        <li>
                            <a href="@Url.Action("Index", "Equipos")"
                               class="submenu-link"
                               data-controller="Equipos"
                               data-action="Index">Lista de Equipos</a>
                        </li>
                        <li>
                            <a href="#movimientosSubmenu"
                               class="submenu-link"
                               data-bs-toggle="collapse"
                               data-controller="Inventario">Movimientos <i class="bi bi-chevron-down arrow-icon"></i></a>
                            <ul class="submenu collapse" id="movimientosSubmenu">
                                <li>
                                    <a href="@Url.Action("Ingresos", "Inventario")"
                                       class="submenu-link nested-submenu-link"
                                       data-controller="Inventario"
                                       data-action="Ingresos">Ingresos</a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Egresos", "Inventario")"
                                       class="submenu-link nested-submenu-link"
                                       data-controller="Inventario"
                                       data-action="Egresos">Entregas / Egresos</a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Devoluciones", "Inventario")"
                                       class="submenu-link nested-submenu-link"
                                       data-controller="Inventario"
                                       data-action="Devoluciones">Devoluciones</a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Kardex", "Inventario")"
                                       class="submenu-link nested-submenu-link"
                                       data-controller="Inventario"
                                       data-action="Kardex">Kardex</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </li>

                <!-- Inventario -->
                <li class="nav-item">
                    <a href="#inventarioSubmenu"
                       class="nav-link"
                       data-bs-toggle="collapse"
                       data-controller="Inventario,Bodegas,Agentes,Contratos">
                        <i class="bi bi-box-seam"></i>
                        <span class="nav-text">Inventario</span>
                        <i class="bi bi-chevron-down arrow-icon"></i>
                    </a>
                    <ul class="submenu collapse" id="inventarioSubmenu">
                        <li>
                            <a href="@Url.Action("Index", "Bodegas")"
                               class="submenu-link"
                               data-controller="Bodegas"
                               data-action="Index">Bodegas</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Agentes")"
                               class="submenu-link"
                               data-controller="Agentes"
                               data-action="Index">Agentes IT</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Contratos")"
                               class="submenu-link"
                               data-controller="Contratos"
                               data-action="Index">Contratos</a>
                        </li>
                    </ul>
                </li>

                <!-- Catálogos -->
                <li class="nav-item">
                    <a href="#catalogosSubmenu"
                       class="nav-link"
                       data-bs-toggle="collapse"
                       data-controller="Categorias,SubCategorias,Equipos">
                        <i class="bi bi-tags"></i>
                        <span class="nav-text">Catálogos</span>
                        <i class="bi bi-chevron-down arrow-icon"></i>
                    </a>
                    <ul class="submenu collapse" id="catalogosSubmenu">
                        <li>
                            <a href="@Url.Action("Index", "Categorias")"
                               class="submenu-link"
                               data-controller="Categorias"
                               data-action="Index">Categorías</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "SubCategorias")"
                               class="submenu-link"
                               data-controller="SubCategorias"
                               data-action="Index">Subcategorías</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Marcas", "Equipos")"
                               class="submenu-link"
                               data-controller="Equipos"
                               data-action="Marcas">Marcas</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Modelos", "Equipos")"
                               class="submenu-link"
                               data-controller="Equipos"
                               data-action="Modelos">Modelos</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Estados", "Equipos")"
                               class="submenu-link"
                               data-controller="Equipos"
                               data-action="Estados">Estados de Equipo</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Ubicaciones", "Equipos")"
                               class="submenu-link"
                               data-controller="Equipos"
                               data-action="Ubicaciones">Ubicaciones</a>
                        </li>
                    </ul>
                </li>

                <!-- Administración -->
                <li class="nav-item">
                    <a href="#administracionSubmenu"
                       class="nav-link"
                       data-bs-toggle="collapse"
                       data-controller="Usuarios,Roles,Permisos">
                        <i class="bi bi-gear"></i>
                        <span class="nav-text">Administración</span>
                        <i class="bi bi-chevron-down arrow-icon"></i>
                    </a>
                    <ul class="submenu collapse" id="administracionSubmenu">
                        <li>
                            <a href="@Url.Action("Index", "Usuarios")"
                               class="submenu-link"
                               data-controller="Usuarios"
                               data-action="Index">Usuarios</a>
                        </li>
                        <li>
                            <a href="#seguridadSubmenu"
                               class="submenu-link"
                               data-bs-toggle="collapse"
                               data-controller="Roles,Permisos">Roles & Permisos <i class="bi bi-chevron-down arrow-icon"></i></a>
                            <ul class="submenu collapse" id="seguridadSubmenu">
                                <li>
                                    <a href="@Url.Action("Index", "Roles")"
                                       class="submenu-link"
                                       data-controller="Roles"
                                       data-action="Index">Roles</a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Index", "Permisos")"
                                       class="submenu-link"
                                       data-controller="Permisos"
                                       data-action="Index">Permisos</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </li>

                <!-- Reportes -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Reportes")"
                       class="nav-link"
                       data-controller="Reportes"
                       data-action="Index">
                        <i class="bi bi-graph-up"></i>
                        <span class="nav-text">Reportes</span>
                    </a>
                </li>

                <!-- Auditoría -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Auditoria")"
                       class="nav-link"
                       data-controller="Auditoria"
                       data-action="Index">
                        <i class="bi bi-clipboard-data"></i>
                        <span class="nav-text">Auditoría</span>
                    </a>
                </li>

                <!-- Configuración -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Configuracion")"
                       class="nav-link"
                       data-controller="Configuracion"
                       data-action="Index">
                        <i class="bi bi-gear"></i>
                        <span class="nav-text">Configuración</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <button class="btn-toggle" id="sidebarToggle" aria-label="Toggle Sidebar">
                <i class="bi bi-chevron-left"></i>
                <span class="btn-toggle-text">Contraer</span>
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <button class="btn-menu-mobile" id="menuMobile" aria-label="Open Menu">
                    <i></i>
                </button>
                <h2 class="page-title">@ViewBag.Title</h2>
            </div>

            <div class="header-right">
                <!-- Notifications -->
                <div class="dropdown notification-dropdown">
                    <button class="btn-icon" type="button" id="notificationDropdown" data-bs-toggle="dropdown">
                        <i class="bi bi-bell"></i>
                        <span class="badge-notification">3</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notificationDropdown">
                        <li class="dropdown-header">Notificaciones</li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item notification-item" href="#">
                                <i class="bi bi-info-circle text-info"></i>
                                <div class="notification-content">
                                    <div class="notification-title">Nuevo equipo registrado</div>
                                    <div class="notification-time">Hace 5 minutos</div>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item notification-item" href="#">
                                <i class="bi bi-exclamation-triangle text-warning"></i>
                                <div class="notification-content">
                                    <div class="notification-title">Equipo por devolver</div>
                                    <div class="notification-time">Hace 1 hora</div>
                                </div>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-center" href="#">Ver todas</a></li>
                    </ul>
                </div>

                <!-- User Menu -->
                <div class="dropdown user-dropdown">
                    <button class="btn-user" type="button" id="userDropdown" data-bs-toggle="dropdown">
                        <div class="user-avatar">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div class="user-info">
                            <span class="user-name">@Session["UserName"]</span>
                            <span class="user-role">@Session["UserRoles"]</span>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                        <li class="dropdown-header">
                            <div class="user-details">
                                <strong>@Session["UserName"]</strong>
                                <small class="text-muted">@Session["UserEmail"]</small>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                <i class="bi bi-person"></i> Mi Perfil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                <i class="bi bi-key"></i> Cambiar Contraseña
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Settings", "Account")">
                                <i class="bi bi-gear"></i> Configuración
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Content Area -->
        <main class="content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-content">
                <div class="footer-left">
                    <p>&copy; @DateTime.Now.Year Zenith Inventory - Sistema de Gestión de Inventario</p>
                </div>
                <div class="footer-right">
                    <span>Versión 1.0.0</span>
                    <span class="separator">|</span>
                    <a href="#">Soporte</a>
                    <span class="separator">|</span>
                    <a href="#">Documentación</a>
                </div>
            </div>
        </footer>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   
    <script src="~/Scripts/errorHandler.js"></script>

    <script src="~/Scripts/utilities.js"></script>

    <script>
        window.zenithContext = {
            controller: '@ViewContext.RouteData.Values["controller"]',
            action: '@ViewContext.RouteData.Values["action"]'
        };       
    </script>

    <script src="~/Scripts/layout.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
